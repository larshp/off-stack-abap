{
  "name": "off-stack-abap",
  "version": "1.0.0",
  "description": "Sample project to demonstrate the usage of off-stack ABAP development.",
  "main": "index.js",
  "homepage": "https://github.com/tobiashofmann/off-stack-abap#readme",
  "repository": "https://github.com/tobiashofmann/off-stack-abap",
  "private": "true",
  "author": {
    "name": "Tobias Hofmann",
    "email": "hof...@outlook.com",
    "url": "https://www.itsfullofstars.de"
  },  "scripts": {
    "lint": "abaplint",
    "transpile": "abap_transpile",
    "patch-runner": "node test/patch-runner.mjs output/index.mjs",
    "test": "node output/index.mjs",
    "test:unit": "npm run transpile && npm run patch-runner && node test/run-unit.mjs",
    "report": "allure generate test-results",
    "docs": "node test/generate-abap-doc.mjs src docs",
    "coverage": "c8 --all --include \"output/**/zcl_*.mjs\" --exclude \"output/**/zcl_*.testclasses.mjs\" --reporter=text --reporter=html --reporter=lcov node test/run-unit.mjs",
    "test:coverage": "npm run transpile && npm run patch-runner && npm run coverage",
    "start": "npm run lint && npm run test:coverage && npm run report && npm run docs"
  },
  "keywords": ["ABAP","abaplint","transpiler","code coverage", "ABAP Unit"],
  "license": "Apache-2.0",
  "type": "commonjs",
  "devDependencies": {
    "@abaplint/cli": "^2.120.57",
    "@abaplint/runtime": "^2.13.90",
    "@abaplint/transpiler-cli": "^2.13.90",
    "allure": "^3.18.0",
    "c8": "^12.0.0"
  }
}
